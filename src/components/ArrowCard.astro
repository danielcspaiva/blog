---
import type { CollectionEntry } from "astro:content";
import { getSlugFromId as getBlogSlugFromId } from "../i18n/blog";
import { getSlugFromId as getProjectSlugFromId } from "../i18n/projects";
import { getLocalizedRoute } from "../i18n/utils";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
  locale?: string;
};

const { entry, locale = 'en' } = Astro.props as {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
  locale?: string;
};

// Generate the URL - always include the locale
let url = '';

// For blogs, use the slug from the ID
if (entry.collection === 'blog') {
  const slug = getBlogSlugFromId(entry.id);
  // Always include locale in the path
  url = `/${locale}/blog/${slug}`;
} else {
  // For projects, use the slug from the ID
  const slug = getProjectSlugFromId(entry.id);
  url = `/${locale}/projects/${slug}`;
}
---

<a
  href={url}
  class="eink-card not-prose group flex flex-nowrap px-4 py-3 pr-10"
>
  <div class="flex flex-1 flex-col truncate">
    <div class="font-pixel font-medium tracking-tight text-ink-950 dark:text-ink-50">
      {entry.data.title}
    </div>
    <div class="mt-0.5 text-sm text-ink-600 dark:text-ink-300">
      {entry.data.description}
    </div>
  </div>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="absolute right-2 top-1/2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2"
  >
    <line
      x1="5"
      y1="12"
      x2="19"
      y2="12"
      class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100"
    ></line>
    <polyline
      points="12 5 19 12 12 19"
      class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-focus-visible:translate-x-0"
    ></polyline>
  </svg>
</a>
