---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import LanguageSwitcher from "@components/LanguageSwitcher.astro";
import { SITE } from "@consts";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header transition:persist>
  <Container>
    <div class="flex flex-wrap items-center justify-between gap-y-2">
      <div>
        <Link href="/" underline={false}>
          <span class="select-none font-pixel text-lg tracking-wide text-ink-950 sm:text-xl dark:text-ink-50">DCSP</span>
        </Link>
      </div>
      <nav class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.12em]">
        <LanguageSwitcher />
        <span class="text-ink-400 dark:text-ink-500">/</span>
        <Link href="/blog">{t('nav.blog')}</Link>
        <span class="text-ink-400 dark:text-ink-500">/</span>
        <Link href="/experience">{t('nav.experience')}</Link>
      </nav>
    </div>
  </Container>
</header>
