---
import PostHogLayout from "@layouts/PostHogLayout.astro";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { SITE, BLOG, getLocalizedMetadata } from "@consts";
import { getCollection } from "astro:content";
import { useTranslations } from "../../../i18n/utils";
import { languages, ui } from "../../../i18n/ui";
import { type BlogPost } from "../../../i18n/blog";

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.params;
const lang = locale as keyof typeof ui;
const localizedBlog = getLocalizedMetadata(BLOG, lang);

const allPosts = await getCollection("blog");
const blog = allPosts
  .filter((post) => !post.data.draft)
  .filter((post) => !post.data.locale || post.data.locale === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()) as BlogPost[];

// Group posts by year
type YearPosts = { [year: string]: BlogPost[] };
const postsByYear = blog.reduce((acc: YearPosts, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(postsByYear).sort(
  (a, b) => parseInt(b) - parseInt(a),
);

// Content based on locale
const content = {
  en: {
    title: localizedBlog.TITLE,
    description: localizedBlog.DESCRIPTION,
  },
  "pt-br": {
    title: localizedBlog.TITLE,
    description: localizedBlog.DESCRIPTION,
  },
};

const pageContent = content[lang];
---

<PostHogLayout>
  <Layout
    title={localizedBlog.TITLE}
    description={localizedBlog.DESCRIPTION}
    pageType="blog"
  >
    <Container>
      <aside>
        <div class="space-y-10">
          <section class="space-y-2">
            <h1 class="font-pixel text-3xl tracking-tight text-ink-950 sm:text-4xl dark:text-ink-50">
              {pageContent.title}
            </h1>
            <p class="text-ink-600 dark:text-ink-300">{pageContent.description}</p>
          </section>
          <div class="space-y-8">
            {
              years.map((year) => (
                <section class="animate space-y-4">
                  <div class="flex items-baseline justify-between border-t hr-eink pt-4">
                    <h2 class="eyebrow text-xs text-ink-700 dark:text-ink-200">
                      {year}
                    </h2>
                    <span class="eyebrow text-[0.7rem] text-ink-500 dark:text-ink-400">
                      [{String(postsByYear[year].length).padStart(2, "0")}]
                    </span>
                  </div>
                  <ul class="not-prose flex flex-col gap-4">
                    {postsByYear[year].map((post) => (
                      <li>
                        <ArrowCard entry={post} locale={locale} />
                      </li>
                    ))}
                  </ul>
                </section>
              ))
            }
          </div>
        </div>
      </aside>
    </Container>
  </Layout>
</PostHogLayout>
